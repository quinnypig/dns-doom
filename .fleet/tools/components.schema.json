{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/schemas/components.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?![A-Za-z]:).+$"
          },
          "profile": {
            "enum": [
              "service",
              "job",
              "static",
              "experiment",
              "presentation",
              "infrastructure",
              "tooling"
            ]
          },
          "lifecycle": {
            "enum": [
              "active",
              "frozen",
              "archived",
              "experimental"
            ]
          },
          "validation": {
            "type": "object",
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?![A-Za-z]:).+$"
                },
                "uniqueItems": true
              },
              "required_checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "command",
              "paths",
              "required_checks"
            ],
            "additionalProperties": false
          },
          "deployment": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "environment": {
                "type": "string",
                "minLength": 1
              },
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "revision_probe": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "owner"
            ],
            "additionalProperties": false
          },
          "telemetry": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "collector",
                  "direct",
                  "none"
                ]
              },
              "service_name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false
          },
          "data": {
            "type": "object",
            "properties": {
              "engine": {
                "type": "string",
                "minLength": 1
              },
              "compatibility_policy": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "engine",
              "compatibility_policy"
            ],
            "additionalProperties": false
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "review_after": {
                  "type": "string",
                  "format": "date"
                }
              },
              "required": [
                "rule",
                "reason",
                "review_after"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "path",
          "profile",
          "lifecycle",
          "validation",
          "deployment",
          "telemetry"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "repository",
    "components"
  ],
  "additionalProperties": false
}
